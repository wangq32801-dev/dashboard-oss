# ──────────────────────────────────────────────
#  个人驾驶舱 · 环境变量示例（复制为 .env 使用）
#  与 dashboard-server.py 实际读取的键一一对应
# ──────────────────────────────────────────────

# 对外端口
DASH_PORT=8787

# ── TickTick（任务/习惯数据源；不配则任务/习惯为空，演示数据仍可用）──
TICKTICK_TOKEN=
# 项目名 → 项目 ID 映射（在 TickTick 客户端或 MCP 输出里查）：
# 格式：PROJECT_IDS=收集箱:inbox,四象限:6xxxxxxxxxxxxxxxxxxxx
PROJECT_IDS=

# ── LLM（AI 管家/顾问/神谕；不配则 AI 功能降级为规则模式，界面仍完整）──
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK=

# ── 可选：视觉理解（预留键；当前版本看图走 LLM_API_*，不用可留空）──
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=

# ── 可选：微信推送目标（定时提醒到微信；不配则提醒仅本地）──
WECHAT_DELIVER=

# ── 可选：界面/AI 称呼（默认「用户」）──
USER_NAME=

# 反向代理使用的域名与完整来源；域名不带协议，来源必须含协议与非默认端口。
# 对外访问必须另配认证和 HTTPS；以下白名单不是身份认证。
DASH_ALLOWED_HOSTS=
DASH_ALLOWED_ORIGINS=
